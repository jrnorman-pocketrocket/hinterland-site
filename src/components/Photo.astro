---
// Serves a photo stored as /images/<name>-800.webp and /images/<name>-1600.webp
interface Props {
  src: string;
  alt: string;
  class?: string;
  sizes?: string;
  eager?: boolean;
}
const { src, alt, class: cls, sizes = '(max-width: 860px) 100vw, 50vw', eager = false } = Astro.props;
---
<img
  class={cls}
  src={`${src}-800.webp`}
  srcset={`${src}-800.webp 800w, ${src}-1600.webp 1600w`}
  sizes={sizes}
  alt={alt}
  width="1600"
  height="1200"
  loading={eager ? 'eager' : 'lazy'}
  fetchpriority={eager ? 'high' : 'auto'}
  decoding="async"
/>
