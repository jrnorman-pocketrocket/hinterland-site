---
import Photo from './Photo.astro';
import type { Trailer } from '../data/site';
interface Props { trailer: Trailer }
const { trailer: t } = Astro.props;
---
<article class="card">
  <a href={`/trailers/${t.slug}/`} tabindex="-1" aria-hidden="true">
    <Photo src={t.photos[0].src} alt={t.photos[0].alt} sizes="(max-width: 700px) 100vw, 360px" />
  </a>
  <div class="card-body">
    <h3><a href={`/trailers/${t.slug}/`} style="color:inherit;text-decoration:none">{t.name}</a></h3>
    <p>{t.summary}</p>
    <div class="card-prices">
      {t.prices.map((p) => (
        <div><strong>${p.amount}</strong><span>{p.label}</span></div>
      ))}
    </div>
    <a class="btn btn--go" href={`/trailers/${t.slug}/#book`}>Check availability</a>
  </div>
</article>
