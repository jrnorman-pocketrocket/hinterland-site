---
import { business, trailers } from '../data/site';
interface Props { bookHref?: string }
const lowest = Math.min(...trailers.flatMap((t) => t.prices.map((p) => p.amount)));
const bookHref = Astro.props.bookHref ?? (trailers.length === 1 ? `/trailers/${trailers[0].slug}/#book` : '/#trailers');
---
<div class="mobile-bar">
  <a class="btn btn--call" href={`tel:${business.phoneIntl}`} aria-label={`Call ${business.phoneDisplay}`}>
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.5c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z"/></svg>
  </a>
  <a class="btn btn--go" href={bookHref}>Book from ${lowest}</a>
</div>
